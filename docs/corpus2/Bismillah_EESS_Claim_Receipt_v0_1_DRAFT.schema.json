{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/bismillah/eess/claim-receipt/0.1.0-draft",
  "title": "Bismillah EESS Claim & Evidence Receipt v0.1 — NON-CANONICAL DESIGN DRAFT",
  "description": "Candidate protocol derived from the October 2026 Differentiator evidence-card template. Not approved or claimed as a functioning EESS API. Source-only evidence does not self-authenticate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "claim",
    "claim_type",
    "tier",
    "status",
    "source_evidence",
    "evidence_independence",
    "method",
    "allowed_action",
    "review",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1.0-draft"
    },
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "claim": {
      "type": "string",
      "minLength": 1
    },
    "claim_type": {
      "enum": [
        "observation",
        "computation",
        "inference",
        "forecast",
        "ethical",
        "theological"
      ]
    },
    "tier": {
      "enum": [
        "Tier 1",
        "Tier 2",
        "Tier 3"
      ]
    },
    "status": {
      "enum": [
        "VERIFIED",
        "PROVISIONAL",
        "UNKNOWN",
        "CONTRADICTED",
        "WITHDRAWN"
      ]
    },
    "source_evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "description": "An empty array is valid for UNKNOWN/PROVISIONAL; never auto-promote an unsupported claim."
    },
    "counterevidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "default": []
    },
    "missing_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "evidence_independence": {
      "enum": [
        "external",
        "correlated",
        "self_produced",
        "mixed",
        "unknown"
      ]
    },
    "dependency_edges": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dependency"
      },
      "default": []
    },
    "method": {
      "$ref": "#/$defs/method"
    },
    "uncertainty": {
      "type": "string",
      "default": ""
    },
    "selection_denominator": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "default": null
    },
    "competing_hypotheses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "predeclared_falsifier": {
      "type": "string"
    },
    "allowed_action": {
      "enum": [
        "no_action",
        "read_only_review",
        "bounded_effect"
      ]
    },
    "effect_authorization": {
      "$ref": "#/$defs/authorization"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes_claim_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "related_habl_finding_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shahid_report_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object",
      "properties": {
        "corpus_release_id": {
          "type": "string"
        },
        "canonical_source_registry_id": {
          "type": "string"
        },
        "source_manifest_signed": {
          "type": "boolean"
        },
        "trust_anchor_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "publisher_attestation": {
      "type": "string",
      "description": "Publisher-provided assertion, NOT an independent external verification."
    },
    "revision_history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "revision_id",
          "status",
          "timestamp"
        ],
        "properties": {
          "revision_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "VERIFIED",
              "PROVISIONAL",
              "UNKNOWN",
              "CONTRADICTED",
              "WITHDRAWN"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "demonstration_only": {
      "type": "boolean",
      "default": false
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "required": [
        "evidence_id",
        "source_id",
        "locator",
        "kind",
        "independence",
        "verification_state"
      ],
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source_quote",
            "file_bytes",
            "recomputed_measurement",
            "reproduction",
            "witness_attestation",
            "publisher_claim",
            "counterexample"
          ]
        },
        "independence": {
          "enum": [
            "external",
            "correlated",
            "self_produced",
            "unknown"
          ]
        },
        "verification_state": {
          "enum": [
            "observed",
            "reproduced",
            "claimed",
            "not_examined",
            "failed"
          ]
        },
        "raw_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_version": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "access_policy": {
          "enum": [
            "public",
            "restricted",
            "private",
            "unspecified"
          ]
        }
      },
      "additionalProperties": false
    },
    "dependency": {
      "type": "object",
      "required": [
        "from_id",
        "to_id",
        "relation"
      ],
      "properties": {
        "from_id": {
          "type": "string"
        },
        "to_id": {
          "type": "string"
        },
        "relation": {
          "enum": [
            "derived_from",
            "shares_key",
            "shares_source",
            "same_evaluator",
            "independently_reproduced",
            "inferred_link",
            "unknown"
          ]
        },
        "witnessed": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false
    },
    "method": {
      "type": "object",
      "required": [
        "name",
        "version",
        "scope"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "method_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "execution_evidence_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": [
        "reviewer",
        "date",
        "authorization"
      ],
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "authorization": {
          "enum": [
            "not_authorized",
            "pending",
            "approved"
          ]
        },
        "independence_note": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "required": [
        "contract_match",
        "effect_type_allowed",
        "target_allowed",
        "witness_healthy",
        "evidence_current",
        "approval_record_id"
      ],
      "properties": {
        "contract_match": {
          "$ref": "#/$defs/three_value"
        },
        "effect_type_allowed": {
          "$ref": "#/$defs/three_value"
        },
        "target_allowed": {
          "$ref": "#/$defs/three_value"
        },
        "witness_healthy": {
          "$ref": "#/$defs/three_value"
        },
        "evidence_current": {
          "$ref": "#/$defs/three_value"
        },
        "approval_record_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "three_value": {
      "enum": [
        "TRUE",
        "FALSE",
        "UNKNOWN"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "allowed_action": {
            "const": "bounded_effect"
          }
        }
      },
      "then": {
        "required": [
          "effect_authorization"
        ],
        "properties": {
          "effect_authorization": {
            "properties": {
              "contract_match": {
                "const": "TRUE"
              },
              "effect_type_allowed": {
                "const": "TRUE"
              },
              "target_allowed": {
                "const": "TRUE"
              },
              "witness_healthy": {
                "const": "TRUE"
              },
              "evidence_current": {
                "const": "TRUE"
              },
              "approval_record_id": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "VERIFIED"
          }
        }
      },
      "then": {
        "properties": {
          "source_evidence": {
            "minItems": 1
          }
        }
      }
    }
  ]
}