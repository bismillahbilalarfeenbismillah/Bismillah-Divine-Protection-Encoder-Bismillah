    "quranic_grounding": {
      "al_hijr_15_9": "Indeed, it is We who sent down the Reminder, and indeed, We will be its Guardian.",
      "yusuf_12_4": "I have seen eleven stars and the sun and the moon; I saw them prostrating to me.",
      "fussilat_41_42": "Falsehood cannot approach it from before it or from behind it; a revelation from One who is Wise and Praiseworthy.",
      "an_najm_53_14": "Near the Lote Tree of the Utmost Boundary.",
      "al_mulk_67_3": "He who created seven heavens in layers.",
      "nuh_71_15": "Do you not see how Allah created seven heavens in layers?",
      "al_mu'minun_23_17": "And We have created above you seven pathways, and We are never unmindful of creation.",
      "al_imran_3_7": "It is He who has sent down to you the Book; in it are verses that are muhkam -- they are the foundation of the Book -- and others that are mutashabih."
    },
